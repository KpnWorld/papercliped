# ── Paperclip ─────────────────────────────────────────────
PAPERCLIP_API_URL=http://localhost:3100
# Board API token (not an agent key). Omit in local_trusted mode. Not used by OAuth clients in `paperclip` login mode.
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_READ_ONLY=0

# ── HTTP bridge ───────────────────────────────────────────
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3939
BRIDGE_PUBLIC_URL=https://bridge.example.com
# Static full-access token (Claude Code headers, ChatGPT Actions). `openssl rand -hex 32`
BRIDGE_TOKEN=

# ── OAuth 2.1 (claude.ai, Claude Desktop/mobile, ChatGPT MCP apps) ──
BRIDGE_OAUTH=0
BRIDGE_SECRET=            # >=32 chars; seals stored Paperclip credentials. `openssl rand -hex 32`
BRIDGE_LOGIN=paperclip    # paperclip | static
BRIDGE_DATA_FILE=/var/lib/paperclip-bridge/state.json
# PAPERCLIP_PUBLIC_URL=https://paperclip.example.com   # browser-facing Paperclip origin for the approval link
# BRIDGE_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com   # "*" = any https host
# BRIDGE_ACCESS_TTL_SEC=3600
# BRIDGE_REFRESH_TTL_SEC=2592000
# BRIDGE_TRUST_PROXY=1    # only behind a proxy you control (affects rate limiting)

# ── Public multi-tenant service (Render + Supabase) ───────
# BRIDGE_MODE=multi                 # each user supplies their own public https Paperclip URL
# DATABASE_URL=postgresql://bridge_app:***@aws-0-us-west-2.pooler.supabase.com:6543/postgres   # transaction pooler, least-privilege role
# DATABASE_MIGRATE_URL=postgresql://postgres.<ref>:***@aws-0-us-west-2.pooler.supabase.com:5432/postgres  # session pooler, admin, migrations only
# DATABASE_SSL=verify               # verify | require | off
# DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# BRIDGE_SECRET_PREVIOUS=           # old secret(s), comma-separated, during rotation
# BRIDGE_PROXY_HOPS=1               # reverse proxies in front (Render = 1)
# BRIDGE_IDLE_REVOKE_DAYS=30        # 0 = never
# BRIDGE_CALLS_PER_MINUTE=120
# BRIDGE_INSTANCE_ALLOWLIST=*.example.com   # private beta: only these Paperclip hosts
# BRIDGE_ALLOWED_PORTS=443
# BRIDGE_AUTO_MIGRATE=0             # run migrations at start (hosts without a pre-deploy hook)

# ── Audit log (the operator PANEL is a separate program, below) ──
# BRIDGE_AUDIT_RETENTION_DAYS=30    # older rows are deleted hourly
# BRIDGE_AUDIT_STDERR=1             # also print each audit event as a JSON line in the host's logs
# BRIDGE_KEEPALIVE=1                # free tiers: self-ping /healthz + write a database heartbeat every 10 min

# ── Operator panel (separate process: `npm run panel`). Give it ONLY these; never BRIDGE_SECRET or DATABASE_URL ──
# PANEL_ADMIN_TOKEN=                # >=24 chars. `openssl rand -hex 32`
# PANEL_DATABASE_URL=postgresql://panel_ro:***@aws-0-us-west-2.pooler.supabase.com:6543/postgres   # READ-ONLY role (docs/panel-role.sql)
# PANEL_DATABASE_SSL=verify         # verify | require | off
# PANEL_DATABASE_CA=
# PANEL_PORT=3940
# PANEL_ALLOWED_IPS=203.0.113.7,10.0.0.0/8   # optional allow-list
# PANEL_PROXY_HOPS=0
# PANEL_PUBLIC_URL=                 # https URL if exposed (marks the session cookie Secure)
# PANEL_COMMUNITY_NAME=cliped       # the name in log lines: "og.kpnwrld - joined cliped"
# PANEL_SLOW_MS=1500
# PANEL_DEMO=1                      # preview with fake data, no database
