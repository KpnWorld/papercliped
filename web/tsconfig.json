{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true, "allowImportingTsExtensions": true, "resolveJsonModule": true, "allowArbitraryExtensions": true,
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"], "noUnusedLocals": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "test", "vite.config.ts", "plugins"]
}
