{
  "name": "paperclip-bridge",
  "version": "0.1.0",
  "description": "Claude (MCP) and ChatGPT (Actions / MCP) plugin to control, sync with and report on a Paperclip instance via its REST API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "paperclip-bridge": "./dist/stdio.js",
    "paperclip-bridge-http": "./dist/http.js"
  },
  "files": [
    "dist",
    "plugin",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "openapi": "node dist/openapi-cli.js > openapi.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
