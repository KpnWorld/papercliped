{
  "name": "papercliped",
  "version": "1.0.0-beta.1",
  "description": "Papercliped \u2014 connect Claude and ChatGPT to your Paperclip: control agents, sync, report. MCP server + hosted multi-tenant OAuth bridge + separate operator panel.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "papercliped": "./dist/stdio.js",
    "papercliped-bridge": "./dist/http.js",
    "papercliped-panel": "./dist/panel/main.js",
    "papercliped-admin": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    ".claude-plugin",
    ".mcp.json",
    "skills",
    "commands",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "openapi": "node dist/openapi-cli.js > openapi.json",
    "migrate": "node dist/cli.js migrate",
    "start": "node dist/http.js",
    "admin": "node dist/cli.js",
    "demo": "node dist/demo.js",
    "schema:sql": "node dist/cli.js schema-sql > docs/supabase-schema.sql",
    "panel": "node dist/panel/main.js",
    "start:panel": "node dist/panel/main.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "pg": "^8.23.1",
    "undici": "^7.30.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KpnWorld/papercliped.git"
  },
  "homepage": "https://papercliped.kpnsolute.com",
  "keywords": [
    "paperclip",
    "mcp",
    "claude",
    "chatgpt",
    "agents",
    "oauth"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
